# Start: copy to .env. Never commit or paste real credentials into chat.
# Demo and live use separate database files. Real sending is OFF by default.
OUTREACH_MODE=demo
PORT=3001
HOST=127.0.0.1
# Optional; defaults to data/rescova-demo.sqlite or data/rescova-live.sqlite.
# DATABASE_PATH=data/rescova-demo.sqlite
# Demo default is rescova-demo. Live requires >=12 characters.
OPERATOR_PASSWORD=
SEED_DEMO=true

# Public HTTPS reverse proxy/tunnel URL, no trailing slash. Must support WSS.
PUBLIC_BASE_URL=
# Only enable after reviewing your own test campaign and recipient list.
LIVE_SEND_ENABLED=false
# Comma-separated E.164 phone numbers / lowercase email addresses you authorize.
# Live worker sends only to these recipients; no wildcard allowed.
OUTBOUND_ALLOWLIST=

# Independent isolated phone test; does not enable campaign sending.
TWILIO_TEST_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
OPENAI_API_KEY=
# Production campaign phone bridge.
OPENAI_REALTIME_MODEL=gpt-realtime
# Browser and isolated Twilio tests: GPT-Live voice and Responses tool backend.
OPENAI_LIVE_MODEL=gpt-live-1
OPENAI_LIVE_BACKEND_MODEL=gpt-5.6-terra

# Optional email channel. A Twilio Voice/SMS account alone does not enable email.
SENDGRID_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
# Event Webhook Verification Key from SendGrid (base64 DER public key).
SENDGRID_EVENT_PUBLIC_KEY=
# Long random secret for Basic auth on /hooks/email/inbound.
EMAIL_INBOUND_SECRET=


# Local Whisper debug recordings and transcription (no cloud ASR).
VOICE_DEBUG_ENABLED=false
WHISPER_PYTHON=
WHISPER_MODEL=
FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
VOICE_DEBUG_DIR=data/voice-debug

# Agent roles: provider-neutral virtual SMS workflow (no physical SMS delivery)
AGENT_WORKFLOWS_ENABLED=false
AGENT_SMS_PROVIDER=openai
AGENT_SMS_MODEL=gpt-5.6-luna
AGENT_SMS_BASE_URL=https://api.openai.com/v1
AGENT_SMS_API_KEY=
AGENT_SUPERVISOR_PROVIDER=openai
AGENT_SUPERVISOR_MODEL=gpt-5.6-terra
AGENT_SUPERVISOR_BASE_URL=https://api.openai.com/v1
AGENT_SUPERVISOR_API_KEY=
OPENROUTER_API_KEY=

# Gmail self-addressed demo email (does not enable portfolio/live sending).
# OAuth setup: npm run gmail:connect — see docs/EMAIL_TEST.md.
EMAIL_TEST_ENABLED=false
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# PostgreSQL and worker deployment (SQLite remains available for isolated tests).
DATABASE_URL=
APP_WORKERS_ENABLED=true
AGENT_WORKER_CONCURRENCY=4
EMAIL_WORKER_CONCURRENCY=2
WORKER_LEASE_MS=60000
WORKER_BATCH_SIZE=40
# WORKER_KIND=all|agent|email|ingestion for npm run worker
DOCUMENT_STORAGE_DIR=data/documents
DOCUMENT_INGEST_CONCURRENCY=1
DOCUMENT_OCR_LANGUAGE=eng
DOCUMENT_PDFTOPPM_PATH=/opt/homebrew/bin/pdftoppm
DOCUMENT_TESSERACT_PATH=/opt/homebrew/bin/tesseract
